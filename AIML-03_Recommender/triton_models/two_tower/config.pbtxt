name: "two_tower"
platform: "onnxruntime_onnx"
max_batch_size: 128

input [
  {
    name: "user_id"
    data_type: TYPE_INT64
    dims: [1]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [32]
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
